# Browser origins allowed to call the API. * is required for Cloudflare Pages
# preview URLs (https://<hash>.jyotish.pages.dev) as well as the production host.
ALLOWED_ORIGINS=*
# Leave empty. A key baked into the static site is public.
API_KEY=
# Password for https://EPHE_DOMAIN/admin. Long random string.
ADMIN_KEY=change-me-to-a-long-random-string
