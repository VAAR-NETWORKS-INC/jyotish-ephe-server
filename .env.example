# Browser origins allowed to call the API. * is required for Cloudflare Pages
# preview URLs (https://<hash>.jyotish.pages.dev) as well as the production host.
ALLOWED_ORIGINS=*
# Leave empty. A key baked into the static site is public.
API_KEY=
# Password for the /admin dashboard. Long random string. Copy this file to .env and set it there.
ADMIN_KEY=
# Server-only. Never put this in the web client or in this example file.
ANTHROPIC_API_KEY=
